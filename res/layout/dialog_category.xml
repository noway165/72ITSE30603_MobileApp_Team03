<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the Add / Edit category dialog (MaterialAlertDialogBuilder.setView).
     Title and Save / Cancel buttons come from the dialog itself. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_l">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCategoryName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_category_name"
        app:counterEnabled="true"
        app:counterMaxLength="30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="30" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleCategoryType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:checkedButton="@id/btnCategoryExpense"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilCategoryName"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCategoryExpense"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/type_expense" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCategoryIncome"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/type_income" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tvColorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/label_color"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleCategoryType" />

    <!-- 8 color swatches; the chosen hex value is read from android:tag -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupColors"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        app:checkedChip="@id/chipColorRed"
        app:chipSpacingHorizontal="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvColorLabel"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorRed"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_red"
            android:tag="#EF4444"
            app:chipBackgroundColor="@color/category_red" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorOrange"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_orange"
            android:tag="#F97316"
            app:chipBackgroundColor="@color/category_orange" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorAmber"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_amber"
            android:tag="#F59E0B"
            app:chipBackgroundColor="@color/category_amber" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorGreen"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_green"
            android:tag="#22C55E"
            app:chipBackgroundColor="@color/category_green" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorTeal"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_teal"
            android:tag="#14B8A6"
            app:chipBackgroundColor="@color/category_teal" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorBlue"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_blue"
            android:tag="#3B82F6"
            app:chipBackgroundColor="@color/category_blue" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorPurple"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_purple"
            android:tag="#8B5CF6"
            app:chipBackgroundColor="@color/category_purple" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipColorPink"
            style="@style/Widget.FinanceTracker.ColorChip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/color_pink"
            android:tag="#EC4899"
            app:chipBackgroundColor="@color/category_pink" />
    </com.google.android.material.chip.ChipGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
