<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation graph of MainActivity. The 5 top-level destinations match menu/bottom_nav_menu.xml.
     Categories and the currency converter are opened from Profile / Dashboard.
     AddEditTransactionActivity is started with an Intent (extra "transaction_id" for edit mode). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="vn.edu.vlu.financetracker.feature.dashboard.ui.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_currency"
            app:destination="@id/currencyConverterFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionListFragment"
        android:name="vn.edu.vlu.financetracker.feature.transaction.ui.TransactionListFragment"
        android:label="@string/title_transactions"
        tools:layout="@layout/fragment_transaction_list" />

    <fragment
        android:id="@+id/budgetFragment"
        android:name="vn.edu.vlu.financetracker.feature.budget.ui.BudgetFragment"
        android:label="@string/title_budgets"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/reportFragment"
        android:name="vn.edu.vlu.financetracker.feature.report.ui.ReportFragment"
        android:label="@string/title_reports"
        tools:layout="@layout/fragment_report" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="vn.edu.vlu.financetracker.feature.profile.ui.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_categories"
            app:destination="@id/categoryFragment" />
        <action
            android:id="@+id/action_profile_to_currency"
            app:destination="@id/currencyConverterFragment" />
    </fragment>

    <fragment
        android:id="@+id/categoryFragment"
        android:name="vn.edu.vlu.financetracker.feature.category.ui.CategoryFragment"
        android:label="@string/title_categories"
        tools:layout="@layout/fragment_category" />

    <fragment
        android:id="@+id/currencyConverterFragment"
        android:name="vn.edu.vlu.financetracker.feature.currency.ui.CurrencyConverterFragment"
        android:label="@string/title_currency_converter"
        tools:layout="@layout/fragment_currency_converter" />

</navigation>
