<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable empty state: icon + title + message. Texts and icon are set per screen in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:importantForAccessibility="no"
        android:padding="18dp"
        android:src="@drawable/ic_list"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.FinanceTracker.SectionTitle"
        tools:text="@string/empty_transactions_title" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="@string/empty_transactions_message" />

</LinearLayout>
