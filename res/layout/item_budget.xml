<?xml version="1.0" encoding="utf-8"?>
<!-- One category budget: category circle + name + percent, progress bar,
     "spent / limit" and "left" text, and a red warning line when the budget is exceeded.
     In code: progress >= 80% -> warning color, > 100% -> expense color + tvOverBudget visible. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBudget"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/tvCategoryInitial"
            android:layout_width="@dimen/icon_circle"
            android:layout_height="@dimen/icon_circle"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/category_blue"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="T" />

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintBottom_toBottomOf="@id/tvCategoryInitial"
            app:layout_constraintEnd_toStartOf="@id/tvPercent"
            app:layout_constraintStart_toEndOf="@id/tvCategoryInitial"
            app:layout_constraintTop_toTopOf="@id/tvCategoryInitial"
            tools:text="Transport" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvCategoryInitial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvCategoryInitial"
            tools:text="82%"
            tools:textColor="@color/warning" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBudget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:max="100"
            app:indicatorColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCategoryInitial"
            app:trackColor="?attr/colorOutlineVariant"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            tools:indicatorColor="@color/warning"
            tools:progress="82" />

        <TextView
            android:id="@+id/tvSpentOfLimit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintEnd_toStartOf="@id/tvRemaining"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBudget"
            tools:text="820.000 ₫ / 1.000.000 ₫" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBaseline_toBaselineOf="@id/tvSpentOfLimit"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="180.000 ₫ left" />

        <!-- Visible only when spent > limit -->
        <TextView
            android:id="@+id/tvOverBudget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_on_brand_box"
            android:backgroundTint="@color/expense_container"
            android:drawablePadding="@dimen/space_s"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/expense"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="@color/expense"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSpentOfLimit"
            tools:text="Over budget by 120.000 ₫"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
