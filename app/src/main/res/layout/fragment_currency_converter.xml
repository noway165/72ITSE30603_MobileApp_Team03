<?xml version="1.0" encoding="utf-8"?>
<!-- Currency converter: amount, From / swap / To currencies, live result and rate,
     plus a card that tells when the cached rates were updated (works offline with the last rates). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.currency.ui.CurrencyConverterFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConverter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/card_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConvertAmount"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_amount"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:startIconDrawable="@drawable/ic_money">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtConvertAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        tools:text="100" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- From  [swap]  To -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFromCurrency"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:hint="@string/hint_from"
                    app:layout_constraintEnd_toStartOf="@id/btnSwap"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilConvertAmount">

                    <AutoCompleteTextView
                        android:id="@+id/actvFromCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:ignore="LabelFor"
                        tools:text="USD" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwap"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="@dimen/space_s"
                    android:contentDescription="@string/cd_swap_currencies"
                    app:icon="@drawable/ic_swap"
                    app:layout_constraintBottom_toBottomOf="@id/tilFromCurrency"
                    app:layout_constraintEnd_toStartOf="@id/tilToCurrency"
                    app:layout_constraintStart_toEndOf="@id/tilFromCurrency"
                    app:layout_constraintTop_toTopOf="@id/tilFromCurrency" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilToCurrency"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_to"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnSwap"
                    app:layout_constraintTop_toTopOf="@id/tilFromCurrency">

                    <AutoCompleteTextView
                        android:id="@+id/actvToCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:ignore="LabelFor"
                        tools:text="VND" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/dividerResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilFromCurrency" />

                <TextView
                    android:id="@+id/tvResultLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/converter_result"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerResult" />

                <TextView
                    android:id="@+id/tvConvertResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.FinanceTracker.Amount"
                    android:textColor="?attr/colorPrimary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvResultLabel"
                    tools:text="2.612.300 ₫" />

                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvConvertResult"
                    tools:text="1 USD = 26.123 VND" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rates status -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRatesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/tvRatesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/converter_rates_title"
                    android:textAppearance="@style/TextAppearance.FinanceTracker.SectionTitle"
                    app:layout_constraintEnd_toStartOf="@id/btnRefreshRates"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLastUpdated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="@id/tvRatesTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvRatesTitle"
                    tools:text="Updated 19/10/2026 07:02" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshRates"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_refresh"
                    app:icon="@drawable/ic_sync"
                    app:layout_constraintBottom_toBottomOf="@id/tvLastUpdated"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvRatesTitle" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressRates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLastUpdated"
                    app:trackCornerRadius="2dp" />

                <!-- "Offline: showing the last saved rates" -->
                <TextView
                    android:id="@+id/tvOfflineNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_on_brand_box"
                    android:backgroundTint="@color/warning_container"
                    android:drawablePadding="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_m"
                    android:text="@string/converter_offline_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/warning"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_warning"
                    app:drawableTint="@color/warning"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progressRates"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
